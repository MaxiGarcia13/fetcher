{
  "name": "fetcher",
  "type": "module",
  "version": "0.56.0",
  "description": "Fetcher is a lightweight and developer-friendly REST API client for testing, debugging, and managing HTTP requests.",
  "author": "Maximiliano Garcia Mortigliengo",
  "license": "ISC",
  "homepage": "https://github.com/MaxiGarcia13/fetcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxiGarcia13/fetcher.git"
  },
  "bugs": {
    "url": "https://github.com/MaxiGarcia13/fetcher/issues"
  },
  "keywords": [
    "rest-api",
    "api-client",
    "http-client",
    "developer-tools",
    "api-testing",
    "rest-client"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "clean": "rm -rf node_modules && rm -rf package-lock.json && rm -rf dist && rm -rf .vercel && rm -rf .astro",
    "phoenix": "npm run clean && npm install",
    "test:e2e": "playwright install chromium && playwright test -x",
    "test:e2e:ui": "playwright install chromium && playwright test --ui"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.4",
    "@astrojs/vercel": "^10.0.6",
    "@maxigarcia/js-utils": "^1.9.0",
    "@nanostores/react": "^1.1.0",
    "astro": "^6.3.1",
    "monaco-editor": "^0.55.1",
    "nanostores": "^1.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^3.0.0",
    "@maxigarcia/eslint-config": "^1.8.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "lint-staged": "^17.0.4",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.0"
  },
  "overrides": {
    "vite": "^7"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,json,jsx,ts,tsx,astro,md}": "npm run lint:fix"
  }
}
