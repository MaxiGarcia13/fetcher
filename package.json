{
  "name": "fetcher",
  "type": "module",
  "version": "0.62.0",
  "description": "Fetcher is a lightweight and developer-friendly REST API client for testing, debugging, and managing HTTP requests.",
  "author": "Maximiliano Garcia Mortigliengo",
  "license": "ISC",
  "homepage": "https://github.com/MaxiGarcia13/fetcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxiGarcia13/fetcher.git"
  },
  "bugs": {
    "url": "https://github.com/MaxiGarcia13/fetcher/issues"
  },
  "keywords": [
    "rest-api",
    "api-client",
    "http-client",
    "developer-tools",
    "api-testing",
    "rest-client",
    "rest",
    "test",
    "testing",
    "api-client",
    "api-rest",
    "testing-tools",
    "api-testing-tools",
    "test-client"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "clean": "rm -rf node_modules && rm -rf package-lock.json && rm -rf dist && rm -rf .vercel && rm -rf .astro",
    "phoenix": "npm run clean && npm install",
    "test:e2e": "playwright install chromium && playwright test -x",
    "test:e2e:ui": "playwright install chromium && playwright test --ui"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@maxigarcia/js-utils": "^1.22.1",
    "@nanostores/react": "^2.0.1",
    "astro": "^7.3.6",
    "monaco-editor": "^0.57.0",
    "nanostores": "^1.5.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.12",
    "@eslint-react/eslint-plugin": "^5.24.8",
    "@maxigarcia/eslint-config": "^1.14.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,json,jsx,ts,tsx,astro,md}": "npm run lint:fix"
  }
}
