---
import Footer from './footer.astro';
import { SavedSessionsPanel } from './saved-sessions';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<aside class={`flex h-full w-64 min-h-0 flex-col gap-4 ${className}`}>
  <div class="flex shrink-0 flex-col gap-4">
    <div class="flex items-center gap-2">
      <img src="/favicon.png" alt="Fetcher" class="h-8 w-8" />
      <h1 class="text-lg font-bold">Fetcher</h1>
    </div>
  </div>

  <SavedSessionsPanel className="min-h-0 flex-1" client:only="react" />

  <Footer />
</aside>
