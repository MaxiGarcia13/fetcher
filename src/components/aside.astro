---
import Footer from './footer.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<aside class={`flex h-full w-64 flex-col ${className}`}>
  <div class="flex flex-col gap-4">
    <div class="flex items-center gap-2">
      <img src="/favicon.png" alt="Fetcher" class="h-8 w-8" />
      <h1 class="text-lg font-bold">Fetcher</h1>
    </div>
  </div>

  <Footer />
</aside>
