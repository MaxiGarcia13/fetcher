---
import { capitalize, cn } from '@maxigarcia/js-utils';
import pkg from '../../package.json';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn('flex w-full shrink-0 flex-col gap-4 sm:flex-row', className)}>
  <div class="flex items-center justify-start gap-2">
    <img src="/favicon.png" alt="Fetcher" class="h-8 w-8" />
    <h1 class="mt-1 text-lg font-bold">{capitalize(pkg.name)}</h1>
    <span class="mt-1 text-xs text-gray-500">v{pkg.version}</span>
  </div>
</div>
