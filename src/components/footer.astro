---
import { cn } from '@maxigarcia/js-utils';
import { GithubIcon } from '@/components/icons/github';
import pkg from '../../package.json';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const repositoryUrl = pkg.repository.url
  .replace(/^git\+/, '')
  .replace(/\.git$/, '');
---

<footer
  class={cn(
    'mt-auto flex items-center justify-center gap-2 text-xs text-app-text-muted',
    className,
  )}
>
  <a
    href={repositoryUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="View repository on GitHub"
    class="inline-flex items-center gap-1.5 text-app-text-muted transition-colors hover:text-app-text"
  >
    <GithubIcon className="size-4" />
    <span class="mt-1">GitHub</span>
  </a>
</footer>
