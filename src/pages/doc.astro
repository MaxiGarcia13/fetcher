---
import Brand from '@/components/brand.astro';
import Footer from '@/components/footer.astro';
import { ChevronLeftIcon } from '@/components/icons/chevron-left';
import { RequestDocTable } from '@/components/request-doc-table';
import AppLayout from '@/layouts/app-layout.astro';
import { parseRequestDocSearchParams } from '@/utils/request-doc';

const requestDoc = parseRequestDocSearchParams(Astro.url.searchParams);
---

<AppLayout>
  <main
    class="mx-auto flex h-full w-full max-w-4xl flex-col gap-8 overflow-y-auto p-6"
  >
    <Brand />

    <div class="space-y-3">
      <div class="flex items-center gap-2">
        <a
          href={`/${Astro.url.search}`}
          class="text-sm text-gray-400 hover:text-gray-300"
        >
          <ChevronLeftIcon className="size-6" />
        </a>
        <h1 class="text-2xl font-bold text-white">Documentation</h1>
      </div>
    </div>

    <section class="space-y-3">
      <h2 class="text-sm font-semibold tracking-wide text-gray-300 uppercase">
        URL
      </h2>
      {
        requestDoc.url ? (
          <p class="rounded border border-gray-700 bg-gray-800 px-3 py-2 text-sm break-all text-gray-100">
            {requestDoc.url}
          </p>
        ) : (
          <p class="text-sm text-gray-500">No URL set.</p>
        )
      }
    </section>

    <RequestDocTable title="Params" rows={requestDoc.params} />
    <RequestDocTable title="Headers" rows={requestDoc.headers} />
    <RequestDocTable title="Body" rows={requestDoc.body} />

    <Footer />
  </main>
</AppLayout>
