---
import Aside from '@/components/aside.astro';
import Brand from '@/components/brand.astro';
import Footer from '@/components/footer.astro';
import { LazyRequestEditor } from '@/components/request-editor';
import { LazyRequestPanel } from '@/components/request-panel';
import AppLayout from '@/layouts/app-layout.astro';
---

<AppLayout>
  <main class="flex h-full w-full flex-col overflow-hidden rounded sm:flex-row">
    <Aside class="hidden border border-app-border bg-app-bg-surface p-4 sm:flex" />

    <!-- Mobile brand -->
    <Brand
      class="flex border border-b-0 border-app-border p-4 pb-0 sm:hidden sm:pb-4"
    />
    <!-- End mobile brand -->

    <div
      class="flex min-h-0 flex-1 flex-col border border-t-0 border-app-border sm:border-t"
    >
      <LazyRequestEditor client:only="react" className="p-4" />
      <LazyRequestPanel client:only="react" className="flex-1" />
    </div>

    <!-- Mobile footer -->
    <div
      class="flex justify-center border border-t-0 border-app-border p-4 sm:hidden"
    >
      <Footer />
    </div>
  </main>
</AppLayout>
